{
  "name": "configforge-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile ./knexfile.ts",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile ./knexfile.ts",
    "seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile ./knexfile.ts",
    "seed:make": "tsx ./node_modules/knex/bin/cli.js seed:make --knexfile ./knexfile.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "async-mutex": "^0.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.0.0",
    "jose": "^5.0.0",
    "knex": "^3.0.0",
    "multer": "1.4.5-lts.2",
    "next-auth": "^4.24.0",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.0.0",
    "pg": "^8.0.0",
    "pino": "^8.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/papaparse": "^5.3.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.0.0",
    "pino-pretty": "^10.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
