# =============================================================================
# ConfigForge Backend Environment Variables
# Copy this to .env for local development, or set via Railway dashboard
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/configforge

# --- Redis (optional: Upstash Redis for production) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (optional: email notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@configforge.dev

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Runtime ---
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=https://your-frontend.vercel.app
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=4096
